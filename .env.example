# EclipseFlow 环境变量模板
# 复制此文件为 .env，然后填入真实值
# docker-compose 会自动读取 .env 文件

# MySQL 数据库密码
DB_PASSWORD=123456

# JWT 密钥（生产环境请务必修改为随机字符串！）
JWT_SECRET=EclipseFlow-JWT-Secret-Key-2026-Must-Be-256-Bits-Long!!
JWT_EXPIRATION_DAYS=7

# VAPID Web Push 密钥对
# 生成方式：node -e "const wp=require('web-push'); console.log(wp.generateVAPIDKeys())"
VAPID_PUBLIC_KEY=BEfDYqG4eOMOiAeUNW3wfUzTPzSx1iBLgoODzGuAEoLwpsJh-VkPugQSvEY5Zu4zXZcnCUoWiaZppxWvuJECoU0
VAPID_PRIVATE_KEY=MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgcx4Jm2fIekV_hWbalsBxCrcH0Q6r4kwrmK-3gn1nZ8WhRANCAARHw2KhuHjjDogHlDVt8H1M0z80sdYgS4KDg8xrgBKC8KbCYflZD7oEErxGOWbuM12XJwlKFommaacVr7iRAqFN

