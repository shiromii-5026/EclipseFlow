# EclipseFlow 环境变量模板
# 复制此文件为 .env，然后填入真实值
# docker-compose 会自动读取 .env 文件

# MySQL 数据库密码
DB_PASSWORD=123456

# JWT 密钥（必填，至少 32 字符的随机串，例如 openssl rand -base64 48）
JWT_SECRET=<在这里填入随机字符串>
JWT_EXPIRATION_DAYS=7

# VAPID Web Push 密钥对（必填）
# 生成方式：node -e "const wp=require('web-push'); console.log(wp.generateVAPIDKeys())"
VAPID_PUBLIC_KEY=<在这里填入生成的公钥>
VAPID_PRIVATE_KEY=<在这里填入生成的私钥>

# AI API 密钥（用于 OCR 智能解析，不填则 OCR 功能不可用）
ANTHROPIC_AUTH_TOKEN=sk-your-deepseek-key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
KIMI_API_KEY=sk-your-kimi-key

# 说明：
# - docker-compose 会自动读取本文件复制出的 .env
# - 本地直接跑（mvn spring-boot:run / python main.py）不读 .env：
#     后端密钥放 eclipse-flow-backend/application-secrets.yml
#     OCR 密钥放 ocr-service/.env
#   这两个文件都已在 .gitignore 里，不会被提交
